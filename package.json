{
  "name": "OUI-CRM",
  "version": "1.1.0",
  "description": "OUI-CRM Backend API",
  "author": "OUI-CRM Team",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --poll",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:restore": "npx tsx prisma/restoreProject.ts",
    "db:seed-e2e": "npx tsx prisma/seedE2eProject.ts",
    "typecheck:seed": "tsc -p tsconfig.seed.json",
    "dev:local": "scripts\\dev-start.bat",
    "docker:rebuild:prod": "docker-compose down && docker-compose build --no-cache api && docker-compose up -d",
    "docker:rebuild:fast:prod": "docker-compose build api && docker-compose up -d",
    "docker:rebuild:dev": "docker-compose -f docker-compose.dev.yml down && docker-compose -f docker-compose.dev.yml build --no-cache api && docker-compose -f docker-compose.dev.yml up -d",
    "docker:rebuild:fast:dev": "docker-compose -f docker-compose.dev.yml build api && docker-compose -f docker-compose.dev.yml up -d",
    "docker:logs": "docker-compose logs -f api",
    "swagger:check": "node -e \"require('dotenv/config');const p=process.env.PORT||3001;require('http').get('http://localhost:'+p+'/api/docs-json',r=>{let d='';r.on('data',c=>d+=c).on('end',()=>{const j=JSON.parse(d);console.log('swagger OK,',Object.keys(j.paths).length,'paths');});}).on('error',e=>{console.error(e.message);process.exit(1);});\"",
    "verify": "npm run build && npm test && npm run typecheck:seed"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/websockets": "^11.1.16",
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/client": "^6.19.2",
    "@react-pdf/renderer": "^4.3.2",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cryptr": "^6.4.0",
    "cuid": "^3.0.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.3.4",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "minio": "^8.0.7",
    "ms": "^2.1.3",
    "nodemailer": "^8.0.1",
    "p-limit": "^3.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg-boss": "^12.15.0",
    "prisma": "^6.19.3",
    "proj4": "^2.20.2",
    "react-pdf-html": "^2.1.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.2.14",
    "babel-plugin-istanbul": "^7.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "test-exclude": "^7.0.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "inflight": "npm:lru-cache@^10.0.0",
    "glob": "^10.0.0",
    "rimraf": "^5.0.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@paralleldrive/cuid2|@noble/hashes)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageProvider": "v8",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
