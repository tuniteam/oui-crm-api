# ============================================
# OUI-CRM API - Variables d'environnement
# Copier en .env et adapter. Aucune valeur secrète ici.
# ============================================

# --- Serveur ---
# Ports locaux distincts de soft-m (API 3000, front 5173) pour faire tourner les deux en parallèle.
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
# Origines front autorisées (CORS), séparées par des virgules. Vide en dev = '*'.
CORS_ORIGINS=http://localhost:5174
# URL du front : cible des liens envoyés par e-mail (/activate, /reset, /email-change)
FRONT_URL=http://localhost:5174
PLATFORM_NAME=OUI-CRM
EMAIL_FROM=no-reply@oui-crm.example

# --- Base de données PostgreSQL ---
# Local sans Docker : service postgresql-x64-18 partagé avec soft-m ; rôle et base créés une fois
# à la main (rôle ouicrm propriétaire de ouicrm_db) ; scripts/dev-start.bat suppose qu'ils existent.
POSTGRES_USER=ouicrm
POSTGRES_PASSWORD=ouicrm_password
POSTGRES_DB=ouicrm_db
DB_PORT=5432
DATABASE_URL="postgresql://ouicrm:ouicrm_password@localhost:5432/ouicrm_db?schema=public"

# --- JWT (sessions) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# --- Comptes : activation, reset de mot de passe, changement d'email ---
ACTIVATION_TOKEN_SECRET=change-me-activation-jwt-secret
ACTIVATION_CRYPTR_SECRET=change-me-activation-cryptr-secret
ACTIVATION_TOKEN_EXPIRATION=72h
PASSWORD_RESET_TOKEN_SECRET=change-me-reset-jwt-secret
PASSWORD_RESET_CRYPTR_SECRET=change-me-reset-cryptr-secret
PASSWORD_RESET_TOKEN_EXPIRATION=30m
EMAIL_CHANGE_TOKEN_SECRET=change-me-email-change-jwt-secret
EMAIL_CHANGE_CRYPTR_SECRET=change-me-email-change-cryptr-secret
EMAIL_CHANGE_TOKEN_EXPIRATION=30m
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
# Requêtes max par IP sur /auth pendant 15 min (50 en prod ; relever en dev pour les scripts de test)
AUTH_RATE_LIMIT_MAX=1000

# --- Emails (Mailpit en local : http://localhost:8025) ---
EMAIL_SENDING_ENABLED=true
SMTP_PROVIDER=mailpit
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_USER=
MAILPIT_SMTP_PASS=
# UAT / production : SMTP réel, SMTP_PROVIDER vide
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Stockage MinIO ---
# Local sans Docker : scripts/dev-start.bat lance le binaire de C:\back\soft-m-storage sur les
# ports 9010/9011 (soft-m garde 9000/9001) avec un data dir séparé et les certificats HTTPS
# auto-signés partagés — d'où MINIO_USE_SSL=true et NODE_TLS_REJECT_UNAUTHORIZED=0 (dev uniquement).
# Docker (docker-compose.dev.yml) : MINIO_PORT=9000, MINIO_USE_SSL=false, PRESIGNED_PUBLIC_URL=http://localhost:9000.
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_USE_SSL=true
NODE_TLS_REJECT_UNAUTHORIZED=0
MINIO_ACCESS_KEY=ouicrm
MINIO_SECRET_KEY=ouicrm_minio_password
MINIO_BUCKET=ouicrm
MINIO_USE_SSE=false
MINIO_PRESIGNED_GET_TTL=900
MAX_FILE_SIZE_BYTES=5000000
# Hôte public des URLs présignées (NGINX en UAT/prod)
PRESIGNED_PUBLIC_URL=https://localhost:9010

# --- Intégrations ---
ENTERPRISE_SEARCH_URL=https://recherche-entreprises.api.gouv.fr

# --- Seed de développement ---
SEED_PASSWORD=Periscolia2026!

# --- Outils locaux (scripts de dev et de test) ---
MAILPIT_HTTP_URL=http://127.0.0.1:8025
MINIO_EXE=C:\back\soft-m-storage\minio.exe
MINIO_CERTS_DIR=C:\back\soft-m-storage\certs
STORAGE_DATA_DIR=C:\back\oui-crm-storage
WEB_DIR=c:\back\oui-crm\oui-crm-web
PRISMA_STUDIO_PORT=5556
FRONT_PORT=5174
