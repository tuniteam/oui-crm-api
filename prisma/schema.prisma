// ============================================
// OUI-CRM - Prisma Schema
// Lot L0 (socle) — SPEC-02 §2, SPEC-06, SPEC-08 phase B.
// Les tables métier (organizations, quotes, contracts…) arrivent
// par migration au lot concerné.
//
// Conventions (SPEC-03 §2.3) : cuid(), colonnes @map(snake_case),
// tables @@map(plural_snake), VarChar bornés, horodatages UTC.
// projectId est NOT NULL sur toute table métier. Il est nullable
// uniquement sur File, EmailLog et AuditLog (données de compte ou
// de plateforme) et sur UserRoleProject (rôle backoffice).
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================================
// ENUMS
// ============================================

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FeatureCode {
  SALES
  BILLING
  SUPPORT
  STATS
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum RelationshipStatus {
  ACTIVE
  SUSPENDED
}

enum ScopeType {
  ALL
  PROJECT
  OWN
}

enum OutOfScopeAccess {
  NONE
  RESTRICTED
  FULL
}

enum ScopeNature {
  ALL
  PROSPECTS
  CUSTOMERS
}

enum FileOwnerType {
  USER
  PROJECT
  ORGANIZATION
  QUOTE
  CONTRACT
  IMPORT_BATCH
}

enum FileCategory {
  AVATAR
  HTML_TEMPLATE
  SIGNATURE_IMAGE
  QUOTE_PDF
  CONTRACT_PDF
  SIGNED_RETURN
  IMPORT_SOURCE
  EXPORT_REPORT
}

/// Document type of an HTML_TEMPLATE file — the active template of a type is the latest uploaded (SPEC-02 §5.3).
enum DocumentTemplateType {
  QUOTE
  CONTRACT
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
}

enum EmailLogType {
  ACTIVATION
  PASSWORD_RESET
  EMAIL_CHANGE
  NOTIFICATION
}

// --------------------------------------------
// L1 — base commerciale (SPEC-13 §2.3).
// Valeurs relevées dans la maquette V8, seule référence fonctionnelle.
// --------------------------------------------

/// Statut commercial — les 5 colonnes du kanban de prospection (US-01-10).
enum SalesStatus {
  NOT_CONTACTED
  TO_CONTACT
  IN_PROGRESS
  MEETING_SCHEDULED
  CLOSED
}

/// Statut client, indépendant du statut commercial.
enum CustomerStatus {
  NOT_CUSTOMER
  DEPLOYING
  ACTIVE
  SUSPENDED
  TERMINATED
  LOST_BEFORE_GOLIVE
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum ActivityStatus {
  PLANNED
  DONE
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// Import profiles (SPEC-05, SPEC-10 §3.3). TERRITORY = geo.api.gouv.fr, sans fichier (US-01-14).
enum ImportProfile {
  GENERIC
  OUICRM_V2_1
  PROJECT_CONFIG
  TERRITORY
}

enum ImportBatchStatus {
  SIMULATED
  APPLIED
  CANCELLED
}

enum DocumentType {
  QUOTE
  INVOICE
}

// --------------------------------------------
// L2 — cycle de vente (SPEC-14 §2.4). Étapes et statuts relevés dans la V8 (SPEC-01 §3.7-3.9).
// --------------------------------------------

/// Étapes du pipeline — clés de Settings.stageProbabilities (le modèle porte déjà le nom
/// OpportunityStage, d'où le suffixe Code). WON et LOST ne sont jamais posés à la main.
enum OpportunityStageCode {
  QUALIFICATION
  DEMONSTRATION
  QUOTE_SENT
  NEGOTIATING
  VERBAL_AGREEMENT
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  PENDING_VALIDATION
  SENT
  FOLLOWED_UP
  NEGOTIATING
  SIGNED
  REJECTED
  EXPIRED
}

enum QuoteType {
  INITIAL
  ADDITIONAL
  RENEWAL
}

/// IMPORTED = devis repris du classeur (SPEC-05 §2.2) : config nulle, jamais recalculé,
/// non régénérable en PDF.
enum QuoteOrigin {
  CRM
  IMPORTED
}

/// Natures de lignes du document, imprimées telles quelles (SPEC-04 §2.2).
enum QuoteLineNature {
  ABONNEMENT
  OPTION
  SETUP
  EXTRA
}

enum BillingMode {
  MONTHLY
  YEARLY
}

/// Seul ACTIVE est écrit au L2 ; le cycle de vie arrive au L3 (SPEC-14 §2.4).
enum ContractStatus {
  ACTIVE
  NOTICE_RECEIVED
  TERMINATED
  EXPIRED
}

// ============================================
// PROJECT — produit ou service à promouvoir (le « client » de soft-m)
// ============================================

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(100)
  productName String        @map("product_name") @db.VarChar(100)
  description String?       @db.VarChar(1000)
  status      ProjectStatus @default(DRAFT)
  activatedAt DateTime?     @map("activated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  features         ProjectFeature[]
  userRoleProjects UserRoleProject[]
  overrides        UserPermissionOverride[]
  roles            Role[]
  scopes           Scope[]
  settings         Settings?
  referenceItems   ReferenceItem[]
  pricingGrids     PricingGrid[]
  auditLogs        AuditLog[]
  files            File[]
  emailLogs        EmailLog[]
  numberSequences  DocumentNumberSequence[]
  organizations    Organization[]

  @@index([status])
  @@map("projects")
}

model ProjectFeature {
  id        String      @id @default(cuid())
  projectId String      @map("project_id")
  feature   FeatureCode
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, feature])
  @@map("project_features")
}

// ============================================
// USERS & SESSIONS
// ============================================

model User {
  id        String  @id @default(cuid())
  email     String  @unique @db.VarChar(255)
  password  String  @db.VarChar(255)
  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String  @map("last_name") @db.VarChar(100)
  phone     String? @db.VarChar(20)

  status UserStatus @default(PENDING)

  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(45)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime? @map("password_changed_at")

  cguVersion     Int?      @map("cgu_version")
  cguAcceptedAt  DateTime? @map("cgu_accepted_at")
  rgpdVersion    Int?      @map("rgpd_version")
  rgpdAcceptedAt DateTime? @map("rgpd_accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions                  Session[]
  activationTokens          ActivationToken[]
  passwordResetTokens       PasswordResetToken[]
  emailChangeTokens         EmailChangeToken[]
  userRoleProjects          UserRoleProject[]
  overrides                 UserPermissionOverride[]
  auditLogs                 AuditLog[]
  uploadedFiles             File[]
  pricingGridsCreated       PricingGrid[]
  organizationsAsSalesRep   Organization[]           @relation("OrganizationSalesRep")
  organizationsAsConsultant Organization[]           @relation("OrganizationConsultant")
  organizationsAsTrainer    Organization[]           @relation("OrganizationTrainer")
  opportunitiesOwned        Opportunity[]            @relation("OpportunityOwner")
  quotesOwned               Quote[]                  @relation("QuoteOwner")
  quotesValidated           Quote[]                  @relation("QuoteValidatedBy")

  @@index([status])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  refreshToken String   @map("refresh_token") @db.VarChar(255) // hash bcrypt
  expiresAt    DateTime @map("expires_at")
  version      Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model ActivationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  userId    String   @map("user_id")
  newEmail  String   @map("new_email") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}

// ============================================
// ROLES, PERMISSIONS, ASSIGNMENTS (SPEC-06)
// ============================================

model Role {
  id               String           @id @default(cuid())
  projectId        String?          @map("project_id") // null = rôle système global
  code             String           @db.VarChar(50)
  label            String           @db.VarChar(100)
  isBackoffice     Boolean          @default(false) @map("is_backoffice")
  isSystem         Boolean          @default(false) @map("is_system")
  outOfScopeAccess OutOfScopeAccess @default(RESTRICTED) @map("out_of_scope_access")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions      RolePermission[]
  userRoleProjects UserRoleProject[]

  @@unique([projectId, code])
  @@map("roles")
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique @db.VarChar(100) // module:action
  label String @db.VarChar(255)

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(cuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  scope        ScopeType @default(PROJECT)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Une affectation = un rôle + un périmètre + des initiales, par projet.
/// projectId null = affectation backoffice (rôle isBackoffice).
model UserRoleProject {
  id           String             @id @default(cuid())
  userId       String             @map("user_id")
  projectId    String?            @map("project_id")
  roleId       String             @map("role_id")
  scopeId      String?            @map("scope_id")
  initials     String             @db.VarChar(3)
  status       RelationshipStatus @default(ACTIVE)
  displayOrder Int                @default(1) @map("display_order")
  expiresAt    DateTime?          @map("expires_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scope   Scope?   @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
  @@unique([projectId, initials])
  @@unique([userId, displayOrder])
  @@index([projectId])
  @@index([status])
  @@map("user_role_projects")
}

/// Surcharge individuelle : granted = true ajoute, false retire. Retrait > ajout > rôle.
model UserPermissionOverride {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  projectId    String  @map("project_id")
  permissionId String  @map("permission_id")
  granted      Boolean

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, permissionId])
  @@map("user_permission_overrides")
}

/// Périmètre géographique (SPEC-02 §4.2).
model Scope {
  id            String      @id @default(cuid())
  projectId     String      @map("project_id")
  name          String      @db.VarChar(100)
  description   String      @default("") @db.VarChar(500)
  regions       String[]    @default([]) @db.VarChar(100)
  departments   String[]    @default([]) @db.VarChar(3)
  portfolioOnly Boolean     @default(false) @map("portfolio_only")
  nature        ScopeNature @default(ALL)
  campaignIds   String[]    @default([]) @map("campaign_ids") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userRoleProjects UserRoleProject[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("scopes")
}

// ============================================
// PROJECT CONFIGURATION (SPEC-10)
// ============================================

model Settings {
  id                      String  @id @default(cuid())
  projectId               String  @unique @map("project_id")
  vatRate                 Decimal @default(20) @map("vat_rate") @db.Decimal(5, 2)
  revenueTarget           Decimal @default(0) @map("revenue_target") @db.Decimal(12, 2)
  meetingTarget           Int     @default(0) @map("meeting_target")
  quoteValidityDays       Int     @default(30) @map("quote_validity_days")
  noticeMonths            Int     @default(2) @map("notice_months")
  defaultCommitmentMonths Int     @default(36) @map("default_commitment_months")
  discountCap             Int     @default(30) @map("discount_cap")
  retentionMonths         Int     @default(36) @map("retention_months")
  /// { QUALIFICATION, DEMONSTRATION, QUOTE_SENT, NEGOTIATING, VERBAL_AGREEMENT, WON, LOST }
  stageProbabilities      Json    @default("{}") @map("stage_probabilities")
  /// { name, siren, siret, rcs, address, phone, email, signatory }
  company                 Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("settings")
}

/// Listes administrables : STRUCTURE_TYPE, TAG, LEAD_SOURCE, SERVICE, ACTIVITY_TYPE,
/// ACTIVITY_RESULT, TICKET_CATEGORY, TRAINING_TYPE, VENDOR, SOLUTION, LOSS_REASON.
model ReferenceItem {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  category  String  @db.VarChar(40)
  key       String  @db.VarChar(60)
  label     String  @db.VarChar(150)
  order     Int     @default(0)
  active    Boolean @default(true)
  metadata  Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, category, key])
  @@index([projectId, category])
  @@map("reference_items")
}

/// Grille tarifaire versionnée — table seule au L0, moteur et routes au L2 (SPEC-04).
model PricingGrid {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  version       Int
  effectiveDate DateTime @map("effective_date") @db.Date
  active        Boolean  @default(false)
  /// { brackets, plans, subscription, options, setupFees, extras }
  content       Json
  createdById   String?  @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  quotes    Quote[]

  @@unique([projectId, version])
  @@index([projectId, active])
  @@map("pricing_grids")
}

/// Séquence de numérotation : un seul update { increment: n } puis calcul en mémoire.
/// periodKey = YYYY-DDD (devis, quotidien) ou YYYY (factures, annuel).
model DocumentNumberSequence {
  id         String       @id @default(cuid())
  projectId  String       @map("project_id")
  type       DocumentType
  periodKey  String       @map("period_key") @db.VarChar(10)
  lastNumber Int          @default(0) @map("last_number")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type, periodKey])
  @@map("document_number_sequences")
}

// ============================================
// AUDIT, FILES, EMAILS — projectId nullable = niveau plateforme / compte
// ============================================

/// Append-only : aucune route ne modifie ni ne supprime.
model AuditLog {
  id         String   @id @default(cuid())
  projectId  String?  @map("project_id")
  userId     String?  @map("user_id")
  action     String   @db.VarChar(45)
  objectType String?  @map("object_type") @db.VarChar(30)
  objectId   String?  @map("object_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@index([objectType, objectId])
  @@map("audit_logs")
}

model File {
  id           String                @id @default(cuid())
  projectId    String?               @map("project_id") // null = fichier de compte (avatar)
  ownerType    FileOwnerType         @map("owner_type")
  ownerId      String                @map("owner_id")
  category     FileCategory
  /// Set on HTML_TEMPLATE files only
  templateType DocumentTemplateType? @map("template_type")
  fileName     String                @map("file_name") @db.VarChar(255)
  filePath     String                @unique @map("file_path") @db.VarChar(512)
  fileSize     Int                   @map("file_size")
  mimeType     String                @map("mime_type") @db.VarChar(100)
  uploadedBy   String                @map("uploaded_by")
  note         String?
  uploadedAt   DateTime              @default(now()) @map("uploaded_at")

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])

  @@index([projectId, ownerType, ownerId])
  @@index([category])
  @@index([projectId, templateType])
  @@map("files")
}

model EmailLog {
  id           String         @id @default(cuid())
  projectId    String?        @map("project_id") // null = email de compte (activation, reset)
  type         EmailLogType
  targetType   String         @map("target_type") @db.VarChar(30)
  targetId     String         @map("target_id")
  recipient    String         @db.VarChar(255)
  status       EmailLogStatus @default(PENDING)
  attempts     Int            @default(0)
  errorMessage String?        @map("error_message")
  sentAt       DateTime?      @map("sent_at")
  createdBy    String?        @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([projectId, status])
  @@map("email_logs")
}

// ============================================
// L1 — BASE COMMERCIALE (SPEC-02 §2.4, SPEC-13 phase A)
// projectId NOT NULL partout. Suppression logique (deletedAt) sur Organization et Contact.
// Index partiels et GIN : dans la migration, Prisma ne les exprime pas.
// ============================================

model Organization {
  id        String @id @default(cuid())
  projectId String @map("project_id")

  // Identité. `region` n'est pas stockée : dérivée du département (geo.constants, SPEC-13 §2.4).
  name          String  @db.VarChar(200)
  type          String  @db.VarChar(60) // clé du référentiel STRUCTURE_TYPE
  displayPrefix String? @map("display_prefix") @db.VarChar(60)
  siret         String? @db.VarChar(14)
  siren         String? @db.VarChar(9)
  inseeCode     String? @map("insee_code") @db.VarChar(5)
  address       String? @db.VarChar(255)
  postalCode    String? @map("postal_code") @db.VarChar(10)
  city          String? @db.VarChar(120)
  department    String  @db.VarChar(3) // même forme que Scope.departments
  population    Int?
  epci          String? @db.VarChar(150)
  phone         String? @db.VarChar(20)
  email         String? @db.VarChar(255)
  website       String? @db.VarChar(255)

  // Environnement produit
  solution    String?  @db.VarChar(60) // clé du référentiel SOLUTION
  schoolCount Int?     @map("school_count")
  childCount  Int?     @map("child_count")
  services    String[] @default([]) @db.VarChar(60) // clés du référentiel SERVICE

  // Suivi commercial
  salesStatus    SalesStatus    @default(NOT_CONTACTED) @map("sales_status")
  customerStatus CustomerStatus @default(NOT_CUSTOMER) @map("customer_status")
  priority       Priority       @default(NORMAL)
  tags           String[]       @default([]) @db.VarChar(60) // clés du référentiel TAG
  leadSource     String?        @map("lead_source") @db.VarChar(60)
  targetPlan     String?        @map("target_plan") @db.VarChar(60)
  salesRepId     String?        @map("sales_rep_id")
  consultantId   String?        @map("consultant_id")
  trainerId      String?        @map("trainer_id")
  notes          String?
  goLiveTarget   DateTime?      @map("go_live_target") @db.Date

  // Colonnes dérivées, maintenues à l'écriture (SPEC-13 §2.4) : filtrées et triées en SQL.
  completenessScore Int       @default(0) @map("completeness_score")
  lastActivityAt    DateTime? @map("last_activity_at")
  nextActivityAt    DateTime? @map("next_activity_at")

  // Traçabilité
  importBatchId     String?   @map("import_batch_id")
  productCustomerId String?   @map("product_customer_id") @db.VarChar(60) // réservé, décision 11
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch?           @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  salesRep      User?                  @relation("OrganizationSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  consultant    User?                  @relation("OrganizationConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  trainer       User?                  @relation("OrganizationTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  activities    Activity[]
  campaigns     CampaignOrganization[]
  opportunities Opportunity[]
  quotes        Quote[]
  contracts     Contract[]

  @@index([projectId, salesStatus])
  @@index([projectId, customerStatus])
  @@index([projectId, department])
  @@index([projectId, salesRepId])
  @@index([projectId, completenessScore])
  @@index([importBatchId])
  @@map("organizations")
}

model Contact {
  id             String  @id @default(cuid())
  projectId      String  @map("project_id")
  organizationId String  @map("organization_id")
  civility       String? @db.VarChar(10)
  firstName      String  @map("first_name") @db.VarChar(100)
  lastName       String  @map("last_name") @db.VarChar(100)
  role           String? @db.VarChar(120)
  email          String? @db.VarChar(255)
  phone          String? @db.VarChar(20)
  mobile         String? @db.VarChar(20)
  isPrimary      Boolean @default(false) @map("is_primary")
  optOut         Boolean @default(false) @map("opt_out")
  notes          String?

  /// true = contact extrait d'une note à l'import : à vérifier par un humain (US-01-04).
  extractedFromNote Boolean   @default(false) @map("extracted_from_note")
  importBatchId     String?   @map("import_batch_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@index([projectId, organizationId])
  @@index([organizationId, isPrimary])
  @@map("contacts")
}

model Activity {
  id             String  @id @default(cuid())
  projectId      String  @map("project_id")
  organizationId String  @map("organization_id")
  contactId      String? @map("contact_id")
  userId         String  @map("user_id")
  campaignId     String? @map("campaign_id")

  type        String         @db.VarChar(60) // clé du référentiel ACTIVITY_TYPE
  date        DateTime       @db.Date
  /// Heure locale « HH:MM », affichée telle quelle ; ICS en heure flottante (SPEC-13 D9).
  time        String?        @db.VarChar(5)
  durationMin Int?           @map("duration_min")
  location    String?        @db.VarChar(255)
  status      ActivityStatus @default(PLANNED)
  report      String?
  result      String?        @db.VarChar(60) // clé du référentiel ACTIVITY_RESULT
  completedAt DateTime?      @map("completed_at")

  /// Estampille d'import (revue de clôture L1) : l'annulation d'un lot retire aussi les
  /// actions créées sur des fiches préexistantes — même contrat que Contact.
  importBatchId String? @map("import_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([importBatchId])
  @@index([projectId, userId, date])
  @@index([organizationId, date])
  @@index([projectId, status, date])
  @@index([campaignId])
  @@map("activities")
}

model Campaign {
  id          String         @id @default(cuid())
  projectId   String         @map("project_id")
  name        String         @db.VarChar(150)
  description String?        @db.VarChar(1000)
  status      CampaignStatus @default(DRAFT)
  ownerId     String?        @map("owner_id")
  startDate   DateTime?      @map("start_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date

  /// Critères de constitution de la cible, à titre documentaire : la liste est figée.
  criteria  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations CampaignOrganization[]
  activities    Activity[]

  @@unique([projectId, name])
  @@index([projectId, status])
  @@map("campaigns")
}

/// Liste cible figée d'une campagne. L'unicité porte l'idempotence de l'ajout en masse.
model CampaignOrganization {
  id             String   @id @default(cuid())
  campaignId     String   @map("campaign_id")
  organizationId String   @map("organization_id")
  addedBy        String?  @map("added_by")
  addedAt        DateTime @default(now()) @map("added_at")

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([campaignId, organizationId])
  @@index([organizationId])
  @@map("campaign_organizations")
}

/// Lot d'import, annulable tant qu'aucune ligne créée n'a été modifiée (US-01-06).
/// Le fichier source est un File de catégorie IMPORT_SOURCE, rattaché par ownerId.
model ImportBatch {
  id         String            @id @default(cuid())
  projectId  String            @map("project_id")
  profile    ImportProfile
  status     ImportBatchStatus @default(SIMULATED)
  /// Compteurs du rapport : { created, updated, skipped, errors, warnings }.
  totals     Json              @default("{}")
  createdBy  String            @map("created_by")
  createdAt  DateTime          @default(now()) @map("created_at")
  canceledAt DateTime?         @map("canceled_at")

  organizations Organization[]

  @@index([projectId, createdAt(sort: Desc)])
  @@map("import_batches")
}

// ============================================
// L2 — CYCLE DE VENTE (SPEC-14 §2.3)
// ============================================

/// Une seule opportunité ouverte par organisme, garantie par un index unique partiel
/// (migration, SQL brut) : WHERE stage NOT IN ('WON','LOST').
model Opportunity {
  id             String @id @default(cuid())
  projectId      String @map("project_id")
  organizationId String @map("organization_id")

  label   String?              @db.VarChar(200)
  stage   OpportunityStageCode @default(QUALIFICATION)
  ownerId String?              @map("owner_id")
  source  String?              @db.VarChar(60) // clé du référentiel LEAD_SOURCE

  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  /// Pondération saisie par le commercial (0-100) : remplace la probabilité de l'étape
  /// pour cette opportunité (SPEC-05 Q4). Effective = override ?? stageProbabilities[stage].
  probabilityOverride Int? @map("probability_override")

  lossReason  String?   @map("loss_reason") @db.VarChar(60) // clé du référentiel LOSS_REASON
  lossComment String?   @map("loss_comment") @db.VarChar(1000)
  closedAt    DateTime? @map("closed_at")

  importBatchId String? @map("import_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?              @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stages       OpportunityStage[]
  quotes       Quote[]

  @@index([projectId, stage])
  @@index([projectId, ownerId])
  @@index([organizationId])
  @@index([importBatchId])
  @@map("opportunities")
}

/// Historique des étapes : table et non JSON, c'est la source des statistiques de
/// conversion et du délai de cycle (SPEC-02 §2.5).
model OpportunityStage {
  id            String               @id @default(cuid())
  opportunityId String               @map("opportunity_id")
  stage         OpportunityStageCode
  date          DateTime             @default(now())
  userId        String?              @map("user_id")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, date])
  @@map("opportunity_stages")
}

/// Devis. Tant qu'il est DRAFT, il est recalculé depuis `config` et la grille active ;
/// à la soumission ses lignes sont matérialisées et `pricingGridId` fige la version
/// — il n'est plus jamais recalculé (SPEC-04 §3.1, SPEC-14 §2.5).
model Quote {
  id             String  @id @default(cuid())
  projectId      String  @map("project_id")
  organizationId String  @map("organization_id")
  opportunityId  String? @map("opportunity_id")
  pricingGridId  String  @map("pricing_grid_id")

  number       String      @db.VarChar(30)
  /// Numéro d'origine d'un devis repris du classeur, conservé tel quel (SPEC-05 §2.2).
  legacyNumber String?     @map("legacy_number") @db.VarChar(30)
  origin       QuoteOrigin @default(CRM)
  type         QuoteType   @default(INITIAL)
  status       QuoteStatus @default(DRAFT)
  ownerId      String?     @map("owner_id")

  issueDate  DateTime  @map("issue_date") @db.Date
  validUntil DateTime  @map("valid_until") @db.Date
  startDate  DateTime  @map("start_date") @db.Date
  signedAt   DateTime? @map("signed_at") @db.Date

  validatedById   String?   @map("validated_by_id")
  validatedAt     DateTime? @map("validated_at")
  rejectionReason String?   @map("rejection_reason") @db.VarChar(1000)
  declineReason   String?   @map("decline_reason") @db.VarChar(1000)

  /// QuoteConfig (SPEC-04 §2.1) ; nulle pour un devis IMPORTED.
  config Json?

  // Montants du QuoteResult, dénormalisés : la liste trie et filtre en SQL (SPEC-14 §2.5).
  mrrList      Decimal @default(0) @map("mrr_list") @db.Decimal(12, 2)
  mrrNet       Decimal @default(0) @map("mrr_net") @db.Decimal(12, 2)
  arrList      Decimal @default(0) @map("arr_list") @db.Decimal(12, 2)
  arrNet       Decimal @default(0) @map("arr_net") @db.Decimal(12, 2)
  oneShotTotal Decimal @default(0) @map("one_shot_total") @db.Decimal(12, 2)
  firstYearHt  Decimal @default(0) @map("first_year_ht") @db.Decimal(12, 2)
  firstYearVat Decimal @default(0) @map("first_year_vat") @db.Decimal(12, 2)
  firstYearTtc Decimal @default(0) @map("first_year_ttc") @db.Decimal(12, 2)
  /// Remise la plus forte du devis, toutes lignes confondues (SPEC-04 déc. 1) :
  /// c'est elle qui déclenche le circuit de validation.
  maxDiscount  Int     @default(0) @map("max_discount")

  /// Devis d'origine d'un renouvellement ou d'une réouverture après expiration.
  sourceQuoteId String? @map("source_quote_id")
  importBatchId String? @map("import_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  pricingGrid  PricingGrid  @relation(fields: [pricingGridId], references: [id])
  owner        User?        @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  validatedBy  User?        @relation("QuoteValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  lines        QuoteLine[]
  contract     Contract?

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([organizationId, status])
  @@index([opportunityId])
  @@index([projectId, validUntil])
  @@index([importBatchId])
  @@map("quotes")
}

/// Lignes figées à la soumission — après elle, le devis n'est plus recalculé.
model QuoteLine {
  id       String          @id @default(cuid())
  quoteId  String          @map("quote_id")
  nature   QuoteLineNature
  order    Int             @default(0)
  label    String          @db.VarChar(200)
  sublabel String?         @db.VarChar(200)

  qty       Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount  Int     @default(0)
  total     Decimal @default(0) @db.Decimal(12, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, order])
  @@map("quote_lines")
}

/// Créé à la signature d'un devis, jamais saisi à la main (SPEC-01 §3.9). Lecture seule
/// au L2 : le cycle de vie (préavis, résiliation, renouvellement) arrive au L3.
model Contract {
  id             String @id @default(cuid())
  projectId      String @map("project_id")
  quoteId        String @unique @map("quote_id")
  organizationId String @map("organization_id")

  number   String   @db.VarChar(30)
  signedAt DateTime @map("signed_at") @db.Date

  startDate        DateTime    @map("start_date") @db.Date
  commitmentMonths Int         @map("commitment_months")
  endDate          DateTime    @map("end_date") @db.Date
  autoRenew        Boolean     @default(true) @map("auto_renew")
  noticeMonths     Int         @map("notice_months")
  billing          BillingMode @default(MONTHLY)
  plan             String      @db.VarChar(60) // clé de PricingGridContent.plans

  // Montants copiés du devis signé (SPEC-04 déc. 2 : catalogue et net, tous les deux).
  mrrList      Decimal @default(0) @map("mrr_list") @db.Decimal(12, 2)
  mrrNet       Decimal @default(0) @map("mrr_net") @db.Decimal(12, 2)
  arrList      Decimal @default(0) @map("arr_list") @db.Decimal(12, 2)
  arrNet       Decimal @default(0) @map("arr_net") @db.Decimal(12, 2)
  oneShotTotal Decimal @default(0) @map("one_shot_total") @db.Decimal(12, 2)

  trialClause Boolean        @default(false) @map("trial_clause")
  status      ContractStatus @default(ACTIVE)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([organizationId])
  @@index([projectId, endDate])
  @@map("contracts")
}
