# ============================================
# OUI-CRM Backend - Docker Ignore
# ============================================

# Dependencies
node_modules
npm-debug.log
yarn-error.log

# Build output
dist
build
coverage

# IDE and editors
.idea
.vscode
*.swp
*.swo
.DS_Store

# Git
.git
.gitignore

# Environment files — sans exception : COPY . . les graverait dans une couche d'image.
# Le compose les injecte à l'exécution (env_file), l'image n'en contient aucun (SPEC-20).
.env*

# Documentation (not needed in container)
docs
*.md
!README.md

# Tests (not needed in production)
test
tests
*.spec.ts
*.test.ts
jest.config.js
coverage

# Claude and other AI configs
.claude

# Postman collection
postman

# Docker files (avoid recursive copy)
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# OS files
Thumbs.db
